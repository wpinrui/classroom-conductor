{
  "name": "classroom-conductor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:rules": "firebase --config firebase.test.json emulators:exec --only database \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,database",
    "engine": "yarn --cwd engine start",
    "test:engine": "yarn --cwd engine test",
    "typecheck:engine": "yarn --cwd engine typecheck"
  },
  "dependencies": {
    "firebase": "^12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@firebase/rules-unit-testing": "^5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "firebase-tools": "^15.33.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "workspaces": [
    "engine"
  ]
}
