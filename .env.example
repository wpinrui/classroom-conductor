# Copy to .env.local. Leave everything blank and set VITE_FIREBASE_EMULATOR=true
# to run against the local emulators (yarn emulators) with no Firebase project.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
